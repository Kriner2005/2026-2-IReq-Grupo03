@startuml DCU-01-SICIRD
title DCU-01-SICIRD · Contexto Quién y que rodea al sistema - Sistema SICIRD (La Tradición) v1.0
left to right direction

actor "Distribuidor-Transportador" as CON
actor "Asesor Comercial" as COM
actor "Jefe / Auxiliar de Bodega" as BOD 
actor "Responsable de Calidad" as CAL
actor "Encargado de Despacho" as DES
actor "Planificador " as TIME <<temporal>>


rectangle "Sistema SICIRD — La Tradición" {
  usecase "CU-01 Registrar entrega en campo" as CU01
  usecase "CU-02 Registrar ingreso de productos" as CU02
  usecase "CU-03 Generar orden" as CU03
  usecase "CU-04 Crear entrega" as CU04
  usecase "CU-05 Generar rutas de entrega" as CU05
  usecase "CU-06 Alertar semáforo de vencimiento" as CU06  
  usecase "CU-07 Generar reporte de trazabilidad INVIMA" as CU07
  }

CON -- CU01
BOD -- CU02
COM -- CU03
BOD -- CU04
DES -- CU05
TIME -- CU06
CAL -- CU07



@enduml